# Supabase project (Database + Auth). See SUPABASE_SETUP.md.
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Server-only. Bypasses RLS — never expose to the client bundle.
# Required for supabaseAdmin (cron webhooks, admin server fns).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Google AI Studio / Gemini API key. https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY="your-google-ai-api-key"

# OpenAI API key. Optional; enables OpenAI in the content studio model selector
# and works as a fallback provider for semantic memory embeddings.
OPENAI_API_KEY="your-openai-api-key"

# Apify token, used for Instagram/Twitter/TikTok/Facebook mention scraping.
APIFY_TOKEN="your-apify-token"

# Telegram delivery. Used by the briefing/alert module.
# Create a bot with @BotFather and use the target group/channel/user chat id.
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"
