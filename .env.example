# ============================================================================
# Informa Ágora — variáveis de ambiente (todas server-side; nada vai ao client)
# Copie para .env (dev) e configure como env de runtime no Coolify (prod).
# ============================================================================

# --- Banco (db_agora / postgresql-alliance-prod) ---------------------------
# Aponte para o schema app. Via Tailscale em dev; rede interna do Coolify em prod.
DATABASE_URL=postgres://agora_app:SENHA@100.83.44.73:15432/db_agora
DATABASE_POOL_MAX=10

# --- better-auth ------------------------------------------------------------
# Gere o secret: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-aleatorio
# URL pública do app (com https em prod). Dev: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Emails (CSV) que viram admin ao criar conta
ADMIN_EMAILS=rb.joaoalves.dev@gmail.com

# --- Google OAuth (Google Cloud Console) ------------------------------------
# Redirect autorizado: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Google AI (Gemini) — geração/classificação de conteúdo -----------------
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# --- ASAAS Payment Bridge (mesmo VPS) --------------------------------------
# Base interna da bridge (rede Coolify/Tailscale). Provisione a key com:
#   POST /v1/admin/api-clients  (header X-Root-Key)  -> guarda ak_...
ASAAS_API_URL=http://asaas-bridge:8000
ASAAS_API_KEY=ak_xxx
# Só se a bridge encaminhar webhooks para /api/public/hooks/asaas
ASAAS_WEBHOOK_SECRET=troque-por-um-segredo

# --- Cron (scheduler externo -> hooks) --------------------------------------
# Header x-api-key usado por /api/public/hooks/refresh-*
CRON_SECRET=troque-por-um-segredo

# --- Scraping ---------------------------------------------------------------
# Apify token, usado para coletar menções de Instagram/Twitter/TikTok/Facebook.
APIFY_TOKEN=
